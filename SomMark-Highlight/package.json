{
  "name": "sommark-highlight",
  "version": "1.1.1",
  "type": "module",
  "description": "Syntax highlighting for SomMark — web and terminal, static and dynamic.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./dynamic": "./src/dynamic.js"
  },
  "files": [
    "src/",
    "index.js",
    "bundle/",
    "dist/"
  ],
  "peerDependencies": {
    "@codemirror/commands": ">=6",
    "@codemirror/state": ">=6",
    "@codemirror/view": ">=6"
  },
  "peerDependenciesMeta": {
    "@codemirror/view": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npx serve . -p 3000",
    "build:cdn": "rollup -c rollup.cdn.config.js",
    "prepublishOnly": "npm run build:cdn"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.61.1",
    "vitest": "^3.2.0"
  },
  "author": "Adam Elmi",
  "keywords": [
    "sommark",
    "syntax-highlight",
    "highlight"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adam-Elmi/SomMark-Highlight.git"
  },
  "dependencies": {
    "js-tokens": "^10.0.0"
  }
}
