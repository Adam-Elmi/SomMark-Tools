[import = Style: "./style.smark"!]
[import = Header: "./header.smark"!]
[import = CollectionsCard: "./collections-card.smark"!]
[import = IconSearchCard: "./icon-search-card.smark"!]
[import = SvgCard: "./svg-card.smark"!]
[import = OutputCard: "./output-card.smark"!]

[DOCTYPE!]
[html = lang: "en"]
  [head]
    [meta = charset: "UTF-8"!]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1.0"!]
    [title]SVG → SomMark[end]
    [Style!]
    [script = src: "https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"][end]
    [script = src: "https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-markup.min.js"][end]
    [script = src: "https://unpkg.com/prettier@3/standalone.js"][end]
    [script = src: "https://unpkg.com/prettier@3/plugins/html.js"][end]
    [link = rel: "preconnect", href: "https://fonts.googleapis.com"!]
    [link = rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "anonymous"!]
    [link = rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"!]
  [end]
  [body]
    [div = class: "wrap"]
      [Header!]
      [CollectionsCard!]
      [IconSearchCard!]
      [SvgCard!]
      [OutputCard!]
    [end]
    [script = src: "https://cdn.jsdelivr.net/npm/sommark-highlight/dist/sommark-highlight.js"][end]
    [script = src: "./app.js", type: "module"][end]
  [end]
[end]
