[div = class: "card"]
  [div = class: "card-header"]
    [span = class: "card-label"]Collections[end]
    [button = class: "collections-toggle", id: "collectionsToggle"]show[end]
  [end]
  [div = class: "collections-body", id: "collectionsBody"]
    [input = class: "collections-search", id: "collectionsSearch", placeholder: "Search collections...", autocomplete: "off", spellcheck: "false" !]
    [span = class: "collections-meta", id: "collectionsMeta"]Loading...[end]
    [div = class: "collections-grid", id: "collectionsGrid"][end]
  [end]
[end]
