[div = class: "divider"]or paste SVG[end]

[div = class: "card"]
  [div = class: "card-header"]
    [span = class: "card-label"]SVG[end]
    [div = class: "card-header-actions"]
      [span = class: "input-format", style: "font-size:0.7rem"]raw <svg> markup[end]
      [button = class: "copy-btn", id: "clearSvgBtn", style: "display:none"]clear[end]
    [end]
  [end]
  [textarea = class: "code-area", id: "svgInput", placeholder: "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"> ... </svg>", spellcheck: "false"][end]
  [pre = class: "code-area", id: "svgDisplay", hidden: "true"][end]
  [button = class: "btn", id: "convertBtn", style: "align-self:flex-start"]Convert[end]
[end]
