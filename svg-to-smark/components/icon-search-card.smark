[div = class: "card"]
  [div = class: "input-label-row"]
    [span = class: "input-label"]icon[end]
    [div = class: "card-header-actions"]
      [span = class: "input-format", id: "inputFormat"][span]collection[end]/name[end]
      [button = class: "collections-toggle", id: "allCollectionsToggle"]search all[end]
    [end]
  [end]
  [div = class: "fetch-row"]
    [input = class: "fetch-input", id: "iconInput", type: "text", placeholder: "ph/github-logo  or  ph/lua  to search", spellcheck: "false", autocomplete: "off" !]
    [button = class: "btn", id: "fetchBtn"]Fetch exact[end]
  [end]
  [span = class: "search-hint", id: "searchHint"][end]
  [div = class: "status", id: "fetchStatus"][end]
  [div = class: "results-wrap", id: "resultsWrap"]
    [div = class: "results-header"]
      [span = class: "results-count", id: "resultsCount"][end]
      [span = class: "results-spinner", id: "resultsSpinner"]searching...[end]
    [end]
    [div = class: "results-grid", id: "resultsGrid"][end]
  [end]
  [div = class: "preview-row"]
    [div = class: "preview-icon", id: "previewIcon"][end]
    [span = class: "preview-name", id: "previewName"]
      [span = class: "preview-empty"]No icon loaded[end]
    [end]
  [end]
[end]
